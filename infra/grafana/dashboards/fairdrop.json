{
 "title": "Fair Drop",
 "uid": "fairdrop",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests / sec by replica",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (instance) (rate(fd_http_requests_total[15s]))",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latency p50 / p95 / p99",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(fd_http_request_seconds_bucket[30s])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(fd_http_request_seconds_bucket[30s])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(fd_http_request_seconds_bucket[30s])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Errors (5xx) vs rate-limited (429)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(fd_http_requests_total{status=~\"5..\"}[15s]))",
     "legendFormat": "5xx",
     "refId": "A"
    },
    {
     "expr": "sum(rate(fd_rate_limited_total[15s]))",
     "legendFormat": "rate limited",
     "refId": "B"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Tokens issued vs entries registered",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(fd_tokens_issued_total)",
     "legendFormat": "tokens",
     "refId": "A"
    },
    {
     "expr": "sum(fd_entries_registered_total)",
     "legendFormat": "entries",
     "refId": "B"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Rejections by reason",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (reason) (rate(fd_requests_rejected_total[15s]))",
     "legendFormat": "{{reason}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Tarpit hits / reused-token attempts",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(fd_tarpit_hits_total[15s]))",
     "legendFormat": "tarpit",
     "refId": "A"
    },
    {
     "expr": "sum(rate(fd_token_reuse_total[15s]))",
     "legendFormat": "token reuse",
     "refId": "B"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Ledger queue",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(fd_ledger_queue_size)",
     "legendFormat": "pending events",
     "refId": "A"
    },
    {
     "expr": "sum(rate(fd_ledger_written_total[15s]))",
     "legendFormat": "written/s",
     "refId": "B"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Claims & state transitions",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (result) (fd_claim_total)",
     "legendFormat": "claim {{result}}",
     "refId": "A"
    },
    {
     "expr": "sum by (to) (fd_transitions_total)",
     "legendFormat": "-> {{to}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Replicas up",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "up{job=~\"api|worker\"}",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ]
  }
 ]
}